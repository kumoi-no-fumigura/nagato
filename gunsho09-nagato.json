   "notes": [
    {
     "a": "山路もやすく越へき",
     "n": "又イ",
     "k": "校異"
    },
    {
     "a": "いかむと契して",
     "n": "待リレイ",
     "k": "校異"
    },
    {
     "a": "法師になりたるひとのもとに",
     "n": "セイ",
     "k": "校異"
    },
    {
     "a": "おなじ夜のあくるあけほのに",
     "n": "のきかくにイ",
     "k": "校異"
    },
    {
     "a": "さけのみしつゐでに",
     "n": "北ノ",
     "k": "校異"
    },
    {
     "a": "誰里にあかす聞らむ",
     "n": "なるイ",
     "k": "校異"
    },
    {
     "a": "ものへ行人に",
     "n": "わかれイ",
     "k": "校異"
    },
    {
     "a": "よし思へなるよしとたに",
     "n": "本ノマヽ",
     "k": "その他"
    }
