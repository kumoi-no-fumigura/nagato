 "poems": [
  {
   "seq": "1",
   "text": "いのり置し神の心もいちしるくむかしの人にあへるけふかな",
   "kana": "",
   "speaker": "",
   "page": 349,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "2",
   "text": "いにしへに光たかはぬ月〓み神の心はさやけかりけり",
   "kana": "",
   "speaker": "",
   "page": 349,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "3",
   "text": "宮こにはまつ人あらん郭公さめぬ枕のやとにしも鳴",
   "kana": "",
   "speaker": "",
   "page": 349,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "4",
   "text": "かた山にはたやくをのこしかやかはみ山櫻はよきてはたやけ",
   "kana": "",
   "speaker": "",
   "page": 349,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "5",
   "text": "さきたてる汀の澤田あらすかもふるみなからに春をくらせる",
   "kana": "",
   "speaker": "",
   "page": 349,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "6",
   "text": "あまかへる鳴や梢のしるへとてぬれなんものを行やわかせこ",
   "kana": "",
   "speaker": "五チ",
   "page": 349,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "7",
   "text": "河上に井せきやすらんこその冬かくしはゝらに岩分る水",
   "kana": "",
   "speaker": "",
   "page": 349,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "8",
   "text": "武隈にいつくたかへりくさむらのみよのうかみに松立る岡",
   "kana": "",
   "speaker": "",
   "page": 349,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "9",
   "text": "たかけれと都もみえす登りてはたゝやくたらむいふゝきの山",
   "kana": "",
   "speaker": "",
   "page": 349,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "10",
   "text": "みやこ人我をこふらし草枕われか旅ねの夢みさはかし",
   "kana": "",
   "speaker": "",
   "page": 350,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "11",
   "text": "山かつの田くろに咲る女郞花われひとりのみゝるそあへなき",
   "kana": "",
   "speaker": "",
   "page": 350,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "12",
   "text": "やまた女のたくろに立る女郞花人待えたる心ちしけめや",
   "kana": "",
   "speaker": "",
   "page": 350,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "13",
   "text": "ぬれ〓〓も明はまつみむ宮城のゝもとあらの萩は萎れしぬ覽",
   "kana": "",
   "speaker": "",
   "page": 350,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "14",
   "text": "河霧は河邊をこめて立にけりいつこ成らむ千鳥なくん",
   "kana": "",
   "speaker": "",
   "page": 350,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "15",
   "text": "しら露にかゝやく月の影みれはくやしやまたきをきにける哉",
   "kana": "",
   "speaker": "",
   "page": 350,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "16",
   "text": "白妙のとよみてくらをとりもちていはひそゝむる紫の野に",
   "kana": "",
   "speaker": "",
   "page": 350,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "17",
   "text": "今よりはあらふる心ましますな花の都にやしろさためて",
   "kana": "",
   "speaker": "",
   "page": 350,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "18",
   "text": "影みしは天つ星なりしかりとて沈むもくつをてらすとはなし",
   "kana": "",
   "speaker": "",
   "page": 350,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "19",
   "text": "月みつゝ待たに有をほとゝきすなそやねなんと思ひける哉",
   "kana": "",
   "speaker": "",
   "page": 350,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "20",
   "text": "老らくの聲かれにけり時鳥來なきとよませはちかくるへく",
   "kana": "",
   "speaker": "",
   "page": 350,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "21",
   "text": "おとゝひもきのふも待し郭公けふさへ鳴すなるや世中",
   "kana": "",
   "speaker": "",
   "page": 350,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "22",
   "text": "もろ共にわかなも摘んいもせ山やま田の澤の水もぬるめて",
   "kana": "",
   "speaker": "く",
   "page": 350,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "23",
   "text": "さゝのはのさゆる霜よも明してき白つむ春の袖そぬれぬる",
   "kana": "",
   "speaker": "",
   "page": 350,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "24",
   "text": "何もせて明ぬるものを菅のねの永きはる日をまたやくらさん",
   "kana": "",
   "speaker": "",
   "page": 350,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "25",
   "text": "身にかへてきかなく花を惜むかないけらは後の春もこそあれ",
   "kana": "",
   "speaker": "",
   "page": 350,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "26",
   "text": "白波のよすれはよするさゝれ石のかとなき物は我身なりけり",
   "kana": "",
   "speaker": "",
   "page": 350,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "27",
   "text": "なをや君われつらからむしからすは霞の影はおるへきものを",
   "kana": "",
   "speaker": "",
   "page": 350,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "28",
   "text": "よのつねのもの思ふ人の袂たにぬるゝはぬるゝ物と聞しを",
   "kana": "",
   "speaker": "",
   "page": 350,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "29",
   "text": "我心かはらむ物かかはらやのしたゝく煙わきかへりつゝ",
   "kana": "",
   "speaker": "",
   "page": 350,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "30",
   "text": "忍ふ思ひひとしくなれはかはら屋の烟ははやとたえにし物を",
   "kana": "",
   "speaker": "",
   "page": 350,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "31",
   "text": "ありへてもあらはやなとそ世中のかく憂き物としりぬとならは",
   "kana": "",
   "speaker": "",
   "page": 350,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "32",
   "text": "いとふとはしらぬにあらす知なから思ふにあらぬ心なりけり",
   "kana": "",
   "speaker": "",
   "page": 350,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "33",
   "text": "命あらは命あらはと思ひつゝうきをもいたく恨みやはする",
   "kana": "",
   "speaker": "",
   "page": 350,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "34",
   "text": "かそふれは空なる星もなにならす何をつらさの數にとらまし",
   "kana": "",
   "speaker": "",
   "page": 350,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "35",
   "text": "聲たえす山ほとゝきすなけゝ共都の人そわきて戀しき",
   "kana": "",
   "speaker": "",
   "page": 350,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "36",
   "text": "郭公しのはぬこゑにつけつゝもわくらむ人やいつれ成らん",
   "kana": "",
   "speaker": "",
   "page": 350,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "37",
   "text": "わか〓とく物思はむ人を又もかなたくひ有けりと聞は賴まむ",
   "kana": "",
   "speaker": "",
   "page": 350,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "38",
   "text": "うき事は我身ひとつのうきなれは處かへてもかひなかりけり",
   "kana": "",
   "speaker": "",
   "page": 350,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "39",
   "text": "ひくらしの鳴夕暮そうかりけるいつも盡せぬ思ひなれとも",
   "kana": "",
   "speaker": "",
   "page": 350,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "40",
   "text": "夕くれはなかむる人のなけれはや心つくしといひはしめけん",
   "kana": "",
   "speaker": "",
   "page": 350,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "41",
   "text": "思へともえそうち出ぬなるすゝのひとつ心にこめてこそふれ",
   "kana": "",
   "speaker": "",
   "page": 350,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "42",
   "text": "あひ思はぬ人をしもなと思ふ覽露よりけなるこなかみをもて",
   "kana": "",
   "speaker": "",
   "page": 350,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "43",
   "text": "所からうかる君にもあらなくにはかなくまとふわか心かな",
   "kana": "",
   "speaker": "",
   "page": 350,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "44",
   "text": "うしとたにいふも更んいさゝらはいさやいかなる我み成らむ",
   "kana": "",
   "speaker": "",
   "page": 350,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "45",
   "text": "いつとてか君かうからぬうきか上に又憂き時はいふかひもなし",
   "kana": "",
   "speaker": "",
   "page": 350,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "46",
   "text": "人心うしとは思知なからさすかに物の忘れかたさよ",
   "kana": "",
   "speaker": "",
   "page": 350,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "47",
   "text": "うき身なり何かおしむと人とはゝ我こたふへきとのは",
   "kana": "",
   "speaker": "",
   "page": 350,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "48",
   "text": "ことたへやかたはおほかるしはのはを我のみ計り心と思はむ",
   "kana": "",
   "speaker": "を君よりほかにたれかしるへさ",
   "page": 350,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "49",
   "text": "うき事も戀しきことも諸共に我みをのみもしる心かな",
   "kana": "",
   "speaker": "",
   "page": 350,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "50",
   "text": "うくはあらて戀しき〓のそはさらはなそや我みのおしからなくに",
   "kana": "",
   "speaker": "",
   "page": 350,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "51",
   "text": "流れあひてそこ共しらすぬれたれは軒の雫におほせてそほす",
   "kana": "",
   "speaker": "",
   "page": 350,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "52",
   "text": "雫おほみ立よる軒の數まさはそのぬれ衣をたれすへやきん",
   "kana": "",
   "speaker": "",
   "page": 350,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "53",
   "text": "雪をうすみ垣ねに摘るからなつなゝつさはまくのほしき君哉",
   "kana": "",
   "speaker": "",
   "page": 350,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "54",
   "text": "かきくらし雲まもみえぬ五月雨ははれす物思ふわか身也けり",
   "kana": "",
   "speaker": "",
   "page": 350,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "55",
   "text": "賴むれは賴まはすこし慰まていとゝえならぬ心地こそすれ",
   "kana": "",
   "speaker": "",
   "page": 350,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "56",
   "text": "うきとも戀しきともふりぬれは何をか今は言の葉にせん",
   "kana": "",
   "speaker": "",
   "page": 350,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "57",
   "text": "有へくもかゝる浮世になそやともけふそ我身を賴みはつへき",
   "kana": "",
   "speaker": "",
   "page": 350,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "58",
   "text": "思ふてふ〓とこそいとゝうき人のうきをしらする心也けれ",
   "kana": "",
   "speaker": "藤原長能集",
   "page": 351,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "59",
   "text": "わひ人の心をすこしなためけむしての山路もやすく越へき",
   "kana": "",
   "speaker": "",
   "page": 351,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "60",
   "text": "數〓〓にたのめし事をあめつちの神も聞けむ物にやはあらぬ",
   "kana": "",
   "speaker": "",
   "page": 351,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "61",
   "text": "ともかくもいふへき方も思ほえすすへて我身の我身ならねは",
   "kana": "",
   "speaker": "",
   "page": 351,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "62",
   "text": "老ぬるも、若きも何もわかめ世にもの思ひにやしなむとすらん",
   "kana": "",
   "speaker": "",
   "page": 351,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "63",
   "text": "おほあききのとをのゝ原に住人をみすてゝ行は袖そ露けき",
   "kana": "",
   "speaker": "",
   "page": 351,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "64",
   "text": "かりにみる袖たにぬるゝ大あらきの杜の雫はいふかたもなし",
   "kana": "",
   "speaker": "",
   "page": 351,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "65",
   "text": "袂にそくみあかしつる夜もすから立わひつらん人の心を",
   "kana": "",
   "speaker": "",
   "page": 351,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "66",
   "text": "なにかその身のいるにしも立かくし心の深き山にすませよ",
   "kana": "",
   "speaker": "",
   "page": 351,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "67",
   "text": "さはへなすあらふる神もをしなへてけふはなこしの秡〓〓",
   "kana": "",
   "speaker": "",
   "page": 351,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "68",
   "text": "ひくらしにみれともあかす女郞花のへにや今宵旅ねしなまし",
   "kana": "",
   "speaker": "",
   "page": 351,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "69",
   "text": "心うき年にも有哉はつかあまりこゝのかといふに春は暮ぬる",
   "kana": "",
   "speaker": "",
   "page": 351,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "70",
   "text": "なけや鳴山ほとゝきす春くれて物さひしかる人きかくれに",
   "kana": "",
   "speaker": "",
   "page": 351,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "71",
   "text": "たちはなの花のさかりに成にけり山郭公きなけしはなけ",
   "kana": "",
   "speaker": "",
   "page": 351,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "72",
   "text": "若草のいもかきなれの唐衣かはしもあへす明るしのゝめ",
   "kana": "",
   "speaker": "",
   "page": 351,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "73",
   "text": "東路の野路の雪まを分てきて哀都の春をみるかな",
   "kana": "",
   "speaker": "",
   "page": 351,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "74",
   "text": "ねさめする秋もこそあれあまの原のとけく照せ夏の夜の月",
   "kana": "",
   "speaker": "",
   "page": 351,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "75",
   "text": "誰里にあかす聞らむほとゝきす有かなきかに鳴わたる也",
   "kana": "",
   "speaker": "",
   "page": 351,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "76",
   "text": "君か代の千とせの松の深みとりさはかぬ水に影はみえつゝ",
   "kana": "",
   "speaker": "",
   "page": 351,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "77",
   "text": "袖ひちて我手に結ふ水の面にあまつ星合の影をみる哉",
   "kana": "",
   "speaker": "",
   "page": 351,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "78",
   "text": "さゝかにのすかく葉末の淺ちより亂てかゝるしら露のたま",
   "kana": "",
   "speaker": "",
   "page": 351,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "79",
   "text": "谷かせにみやまの花やのこり有と打て渡れるみつもさはくに",
   "kana": "",
   "speaker": "",
   "page": 351,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "80",
   "text": "優婆塞か行かふやまの山さくらけふの行幸のためにさりける",
   "kana": "",
   "speaker": "",
   "page": 351,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "81",
   "text": "佐保姫の玉おちにけりから錦おれる木のはのうへの白露",
   "kana": "",
   "speaker": "",
   "page": 351,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "82",
   "text": "いにしへも今もあらんやわか如く思ひ盡せぬ思ひするひと",
   "kana": "",
   "speaker": "",
   "page": 351,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "83",
   "text": "しらかしの知らぬ山路を尋ぬれは高根の續きならせるやたれ",
   "kana": "",
   "speaker": "",
   "page": 351,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "84",
   "text": "ことしけみ見れは流るゝ薄墨のかすめし〓とやしるらんやきみ",
   "kana": "",
   "speaker": "",
   "page": 351,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "85",
   "text": "定めてそ立もよるへき世の人のあひてもあはぬものは思はし",
   "kana": "",
   "speaker": "",
   "page": 351,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "86",
   "text": "つれ〓〓と物思ふ事の盡せぬをくるしき物としるや知すや",
   "kana": "",
   "speaker": "",
   "page": 351,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "87",
   "text": "思ふらむおなし心にあらはこそくるしきものと聞もなやまめ",
   "kana": "",
   "speaker": "",
   "page": 351,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "88",
   "text": "あふ事のはに置し露はきえにしを世に有とてや人のとふらん",
   "kana": "",
   "speaker": "",
   "page": 351,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "89",
   "text": "秋きりは川邊にさへそ立にけるいつこ成らん千鳥鳴なり",
   "kana": "",
   "speaker": "",
   "page": 351,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "90",
   "text": "ひくらしに見れともあかぬ紅葉々はいかなる山の嵐なるらん",
   "kana": "",
   "speaker": "",
   "page": 351,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "91",
   "text": "はやきせにのほるますらおこりすまに此夕暮を賴むへらなれ",
   "kana": "",
   "speaker": "",
   "page": 351,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "92",
   "text": "我心散り失せぬきくにたとふれは花こそいたく移ろひにけれ",
   "kana": "",
   "speaker": "",
   "page": 351,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "93",
   "text": "千早ふる天の岩とををしひらき我にかたよれみこもりの神",
   "kana": "",
   "speaker": "",
   "page": 351,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "94",
   "text": "あめつちの神ふりかけて誓ひてし〓となる空に成にける哉",
   "kana": "",
   "speaker": "藤原長能集",
   "page": 351,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "95",
   "text": "こす波に袖うちぬらしかへりしも哀と思ひかけつらむやそ",
   "kana": "",
   "speaker": "",
   "page": 351,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "96",
   "text": "よし思へなるよしとたにみましかは浪こしけりとみせましやそは",
   "kana": "",
   "speaker": "",
   "page": 351,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "97",
   "text": "獨ねの夜の衣にあられともかへすはつらき物にそ有ける",
   "kana": "",
   "speaker": "",
   "page": 351,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "98",
   "text": "山端のうちなる松の枝しけみさやかにみえぬ春のよの月",
   "kana": "",
   "speaker": "",
   "page": 351,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "99",
   "text": "道ゆきにみれともあかぬ紅葉かなむへこそ人も家居せりける",
   "kana": "",
   "speaker": "",
   "page": 351,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "100",
   "text": "やたのなる藻屑やはらのつかのまもこひすやあらぬ花の都を",
   "kana": "",
   "speaker": "",
   "page": 351,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "101",
   "text": "こゝにともしらてや君かすきぬらんたてはかなしき深草の里",
   "kana": "",
   "speaker": "",
   "page": 351,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "102",
   "text": "覺束な誰かきつけし〓とのはそみれは涙のかきくらしつゝ",
   "kana": "",
   "speaker": "",
   "page": 351,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "103",
   "text": "咲もせす散〓ともなききくの花みよのためしを賴みてそふる",
   "kana": "",
   "speaker": "",
   "page": 351,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "104",
   "text": "その神のなかよしとたゝしりぬれは人の數ともおもほえぬ哉",
   "kana": "",
   "speaker": "",
   "page": 351,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "105",
   "text": "理やしか憂き身なりしかあれともよしまさゝらむ人は誰そは",
   "kana": "",
   "speaker": "藤原長能集",
   "page": 352,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "106",
   "text": "世の常に思ふわかれのたひならは心みえなるたむけせましや",
   "kana": "",
   "speaker": "",
   "page": 352,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "107",
   "text": "明暮のほともやみると心みに八重立こめよ秋の河きり",
   "kana": "",
   "speaker": "",
   "page": 352,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "108",
   "text": "岩波や吉野のもみち散ぬへし浪とゝもにもおれぬけふ哉",
   "kana": "",
   "speaker": "",
   "page": 352,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "109",
   "text": "おらすして行むものかは遠近のはやまおく山よるはこゆとも",
   "kana": "",
   "speaker": "",
   "page": 352,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "110",
   "text": "日くるれは遙にかゝるから衣さほしかねつるころにも有かな",
   "kana": "",
   "speaker": "",
   "page": 352,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "111",
   "text": "うはとよみとよみにけりな淀河の底にもこひんのとけからめに",
   "kana": "",
   "speaker": "",
   "page": 352,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "112",
   "text": "ひとへたにあかぬ心をいとゝしくやへかさなれる山吹の花",
   "kana": "",
   "speaker": "",
   "page": 352,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "113",
   "text": "常よりは思ふ〓となき身にしあれはなぬかふる共何かとそ思ふ",
   "kana": "",
   "speaker": "",
   "page": 352,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "114",
   "text": "五月雨はすきにたりとやあし曳の山郭公なく聲もせす",
   "kana": "",
   "speaker": "",
   "page": 352,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "115",
   "text": "五月雨は世にうき物とほとゝきす鳴かくれにしこゑな聞せそ",
   "kana": "",
   "speaker": "",
   "page": 352,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "116",
   "text": "うかりけるその五月雨は過にしを今はゝやきてよしと語らん",
   "kana": "",
   "speaker": "",
   "page": 352,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "117",
   "text": "風を傷みこりすまなみに立出て蜑よいかなるめをかみるへき",
   "kana": "",
   "speaker": "",
   "page": 352,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "118",
   "text": "海士のきるしほたれ衣ほさすして明石の浦そわひしかりける",
   "kana": "",
   "speaker": "",
   "page": 352,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "119",
   "text": "けふりたにすこしたなひけ朝なきに灘のしほ燒いとまなく共",
   "kana": "",
   "speaker": "",
   "page": 352,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "120",
   "text": "なたのうらに絕ぬ·烟はたえぬとも思はぬ方へみともせもせし",
   "kana": "",
   "speaker": "",
   "page": 352,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "121",
   "text": "諸共にこそさふらひし老らくの獨はみえすなりていく世に",
   "kana": "",
   "speaker": "",
   "page": 352,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "122",
   "text": "したつえにさかすしもあらす櫻花いかてかゝけむ墨染の袖",
   "kana": "",
   "speaker": "",
   "page": 352,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "123",
   "text": "老らくのなれるすかたの池に生るはちなきこひも我はする哉",
   "kana": "",
   "speaker": "",
   "page": 352,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "124",
   "text": "つれ〓〓の夏の日くらし戀しきにかみのしらへもして心みむ",
   "kana": "",
   "speaker": "",
   "page": 352,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "125",
   "text": "東路の野路の契リはへたつとも扇のかせのたよりあらしや",
   "kana": "",
   "speaker": "",
   "page": 352,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "126",
   "text": "行するに神そしるらむいはすともこは大ぬきの手向ならぬを",
   "kana": "",
   "speaker": "",
   "page": 352,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "127",
   "text": "武藏野の草のゆかりを尋ね見はたよりをしもはなとか待へき",
   "kana": "",
   "speaker": "",
   "page": 352,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "128",
   "text": "さりそむ袂も早く朽にけむ軒のした葉の露をたにみよ",
   "kana": "",
   "speaker": "",
   "page": 352,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "129",
   "text": "わかるらんとまるもおなし武藏のゝ木の下露は風も吹あへす",
   "kana": "",
   "speaker": "",
   "page": 352,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "130",
   "text": "いつれをかわきて忍はむふたこより思ふ心はひとつなりとて",
   "kana": "",
   "speaker": "",
   "page": 352,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "131",
   "text": "谷河の氷もいまたきえあへぬに岸の霞はたな引にけり",
   "kana": "",
   "speaker": "",
   "page": 352,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "132",
   "text": "我やとの軒端の梅やさきぬらん鶯きなく聲きこゆなり",
   "kana": "",
   "speaker": "",
   "page": 352,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "133",
   "text": "春たへはいつしかみむと待ものを遲くもさける櫻はなかな",
   "kana": "",
   "speaker": "",
   "page": 352,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "134",
   "text": "いやしきに浪うちーくとみえつるは峯の櫻のかけにさりける",
   "kana": "",
   "speaker": "",
   "page": 352,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "135",
   "text": "けふ咲てあすは散ぬるさくら花よは早〓〓に物をこそ思へ",
   "kana": "",
   "speaker": "",
   "page": 352,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "136",
   "text": "そこ〓く井手の川瀨にかけみえて今さかりなる山ふきの花",
   "kana": "",
   "speaker": "",
   "page": 352,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "137",
   "text": "花さくら散しはきのふ靑柳のはやまにけふはうくひすそ鳴",
   "kana": "",
   "speaker": "",
   "page": 352,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "138",
   "text": "夏くれは山ほとゝきす鳴やせむと思ふ心そめはさましける",
   "kana": "",
   "speaker": "",
   "page": 352,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "139",
   "text": "おなしなを花橘のはなさかりみしかき夜こそわひしかりけれ",
   "kana": "",
   "speaker": "",
   "page": 352,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "140",
   "text": "ふしつけし淀の渡りをけさみれはとけむこもなく氷しにけり",
   "kana": "",
   "speaker": "",
   "page": 352,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "141",
   "text": "ひとりぬる人もこそあれ一つかひ鳴なるをしの聲やかなしき",
   "kana": "",
   "speaker": "",
   "page": 352,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "142",
   "text": "いつくにか駒もとゝめむもみちはの色なる物は心なりけり",
   "kana": "",
   "speaker": "",
   "page": 352,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "143",
   "text": "ねさめする秋もこそあれ天の原のとけくてこそ夏のよの月",
   "kana": "",
   "speaker": "",
   "page": 352,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "144",
   "text": "何れをか世になかれとは思ふへき忘るゝ人とわすらるゝ身と",
   "kana": "",
   "speaker": "",
   "page": 352,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "145",
   "text": "人の上を我に語りしそのかみもそよ添はさりし口つきそかし",
   "kana": "",
   "speaker": "",
   "page": 352,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "146",
   "text": "うとからぬなも有ものをいもせ山たちなかくしそ春の霞も",
   "kana": "",
   "speaker": "",
   "page": 352,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "147",
   "text": "うの花のしけきかきねとなるまゝに隣にかよふ道そたえぬる",
   "kana": "",
   "speaker": "",
   "page": 352,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "148",
   "text": "戀しさそ忘れさりける山里はうらみていてしわか身なれとも",
   "kana": "",
   "speaker": "",
   "page": 352,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  }
 ],
